{
    "name": "chronhub/storm-story",
    "description": "Storm Story — command / query / event buses on Symfony Messenger.",
    "type": "library",
    "license": "MIT",
    "keywords": ["ddd", "cqrs", "event-sourcing", "messenger", "command-bus"],
    "require": {
        "php": ">=8.5",
        "chronhub/storm-bureau": "self.version",
        "chronhub/storm-chronicler": "self.version",
        "chronhub/storm-contracts": "self.version",
        "chronhub/storm-message": "self.version",
        "chronhub/storm-serializer": "self.version",
        "psr/container": "^2.0",
        "psr/event-dispatcher": "^1.0",
        "symfony/console": "^8.1",
        "symfony/dependency-injection": "^8.1",
        "symfony/messenger": "^8.1.1"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.2.8",
        "phpunit/phpunit": "^13.3.0"
    },
    "autoload": {
        "psr-4": {
            "Storm\\Story\\": "./"
        },
        "exclude-from-classmap": [
            "/Tests/"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Storm\\Story\\Tests\\": "Tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
